---
import 'katex/dist/katex.min.css'
import '~/styles/post.css'
import Layout from '~/layouts/layout.astro'
import { render, type CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { Content } = await render(post)

const date = post.data.date.toISOString().slice(0, 10)
---

<Layout
  title={post.data.title}
  description={post.data.description}
  bgtext={post.data.bgtext}>
  <article class="bg-butterstick text-ovenglow mx-auto p-4 bg-lines-diagonal">
    <header class="pb-4">
      <h1 class="font-archivo text-3xl sm:text-4xl">{post.data.title}</h1>
      <p class="font-corm text-xs mt-2">
        <time datetime={date}>{date}</time>
        {post.data.description && <span> • {post.data.description}</span>}
      </p>
    </header>
    <div class="bg-rainbow h-1.5 mb-6" aria-hidden="true"></div>
    <div class="post-body">
      <Content />
    </div>
  </article>
</Layout>
