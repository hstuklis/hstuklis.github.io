---
import Config from '~/config'

const SiteName = Astro.url.pathname === '/' ? 'h1' : 'div'

const link =
  'hover:text-sardinetin hover:underline hover:decoration-wavy focus-visible:bg-butterstick focus-visible:text-ovenglow focus-visible:outline-none'
---
<header class="fixed top-0 inset-x-0 z-20 mx-auto max-w-7xl px-4">
  <div class="bg-rainbow-chrome h-1.5 mt-2" aria-hidden="true"></div>
  <nav class="flex flex-col sm:flex-row sm:justify-between sm:items-end py-1 font-bold" aria-label="Header Navigation">
    <SiteName class="text-2xl pr-8 font-archivo tracking-tighter"><a class={link} href="/" title="Home">{Config.title}</a></SiteName>
    <ul class="flex flex-row text-lg font-archivo tracking-tighter">
      <li><a class={link} href="/posts" title="Posts">POSTS</a></li>
      {/* TODO: restore once /wedding is rebuilt (page was removed)
      <li class="mx-1" aria-hidden="true">•</li>
      <li><a class={link} href="/wedding" title="🌹My Wedding Website🌹">🌹Wedding🌹</a></li>
      */}
    </ul>
  </nav>
</header>
